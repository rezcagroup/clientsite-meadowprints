{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/product/:slug", "destination": "/product" },
    { "source": "/products/:category", "destination": "/products" },
    { "source": "/brands/:brand", "destination": "/products" },
    { "source": "/use-cases/:section", "destination": "/use-cases" },
    { "source": "/how-it-works/:section", "destination": "/how-it-works" },
    { "source": "/about/:section", "destination": "/about" }
  ],
  "headers": [
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/llms.txt", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] }
  ]
}
